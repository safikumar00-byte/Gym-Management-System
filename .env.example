# ==============================================================================
# GYM MANAGER SaaS — LOCAL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port and Node Environment
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Supabase Two-URL Architecture for Vercel / Production)
# ------------------------------------------------------------------------------
# 1. RUNTIME DATABASE URL: Supabase Transaction Pooler (Port 6543)
# Used by Vercel Serverless Functions & Express API runtime
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. DIRECT DATABASE URL: Supabase Direct PostgreSQL Connection (Port 5432)
# Used by Drizzle Kit schema migrations and administrative tasks
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Database Settings
DATABASE_MODE=supabase-pooler
SQL_SSL=true
SQL_MAX_CONNECTIONS=10

# OPTION 4 (Legacy / Rollback): Cloud SQL Auth Proxy
# DATABASE_MODE=local-proxy
# SQL_HOST=127.0.0.1
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=your_cloud_sql_password
# SQL_DB_NAME=postgres
# SQL_SSL=false

# OPTION 5 (Offline Local Dev): Local PostgreSQL / Docker Container
# docker run --name gym-postgres -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=postgres -d postgres:16-alpine
# DATABASE_MODE=local
# SQL_HOST=127.0.0.1
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=postgres
# SQL_DB_NAME=postgres
# SQL_SSL=false

# ------------------------------------------------------------------------------
# AI & INTEGRATION SERVICES
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI workout/analytics assistance
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Base URL for web application links and redirects
APP_URL=http://localhost:3000
